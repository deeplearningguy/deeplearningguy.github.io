---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GITHUB_URL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={`About ${SITE_TITLE}`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<!-- TODO: write a short bio -->
			<p>
				I write about deep learning here. You can find my code on
				<a href={GITHUB_URL}>GitHub</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
